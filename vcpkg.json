{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "vcpkg-example-curl",
  "version": "1.0.0",
  "description": "Illustrating how to use vcpkg to set up C project and manage its dependencies",
  "homepage": "https://github.com/mancap314/vcpkg-example-curl",
  "license": "MIT",
  "builtin-baseline": "3b3777fa3cd0c99a3ceba914e71ba75cf43d4219",
  "dependencies": [
    {
      "name": "curl",
      "features": [
        "http2",
        "openssl"
      ],
      "version>=": "8.5.0"
    },
    {
      "name": "lexbor",
      "version>=": "2.6.0"
    },
    {
      "name": "check",
      "version>=": "0.15.2#5"
    }
  ]
}
